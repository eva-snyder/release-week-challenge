# Last.fm API — create an application at https://www.last.fm/api/account/create
# Set the callback URL to match production/dev, e.g. http://127.0.0.1:8787/auth/callback
LASTFM_API_KEY=your_api_key
LASTFM_API_SECRET=your_api_secret
# Optional: set to 1 to add per-request `cb=` to the Last.fm auth URL. Default (omit) uses only the
# callback URL saved in your Last.fm app — try that first if Last.fm doesn't redirect after approve.
# LASTFM_AUTH_USE_CB=1

# Public site origin (no trailing slash)
FRONTEND_ORIGIN=http://127.0.0.1:5173

SESSION_SECRET=change_me_to_a_long_random_string

# Optional: salt for picking one prize winner when multiple listeners tie at #1 (defaults to SESSION_SECRET).
# Change only if you need a different tie-break without rotating session cookies.
# PRIZE_TIE_BREAK_SECRET=

# Challenge (optional overrides — defaults in backend/src/challenges.js match a short turkeys test window)
# CAMPAIGN_TITLE=Release challenge
# CAMPAIGN_ARTIST=Eva Snyder
# CAMPAIGN_TRACK_NAME=turkeys
# CAMPAIGN_STARTS_AT=2026-03-27T00:00:00Z
# CAMPAIGN_ENDS_AT=2026-04-01T00:00:00Z
# Optional: Spotify track id for hero link (open.spotify.com/track/…). CAMPAIGN_TRACK_ID is accepted too.
# If unset, the API falls back to a default track id in code (see challenges.js).
# CAMPAIGN_SPOTIFY_TRACK_ID=
# Optional: Spotify share id for ?si=… on the track link (matches “Copy link” from Spotify).
# CAMPAIGN_SPOTIFY_SI=

# Artist mode: Last.fm username (lowercase match) for /api/admin/* tools
# ARTIST_LASTFM_USERNAME=your_lastfm_username
#
# Multi-challenge history: each row in `challenges` has its own id; `plays` keep challenge_id forever.
# To start a fresh campaign without overwriting the same row, use POST /api/admin/challenge (artist).
# GET /api/admin/stream-totals — per-user / per-challenge play counts across all stored challenges.

# SQLite path (default ./data.sqlite)
# DB_PATH=./data.sqlite

# Ingest schedule (cron)
# INGEST_CRON=*/15 * * * *
