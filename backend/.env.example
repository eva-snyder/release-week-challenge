PORT=8787
DB_PATH=./data.sqlite

# Your Spotify app credentials (keep secret in real deployments)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# OAuth scopes include user-read-email so listener emails can be stored for prize follow-up.
# In the Spotify Developer Dashboard, ensure your app is allowed to request that scope (default for web apps).

# Where Spotify redirects back to your backend
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/auth/callback

# After Spotify login we redirect here. MUST use 127.0.0.1 (not localhost) if your
# Spotify redirect URI is http://127.0.0.1:8787/auth/callback — otherwise session
# cookies won’t match (localhost vs 127.0.0.1 are different hosts).
# Example: http://127.0.0.1:5173
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Cookie signing secret (any long random string)
SESSION_SECRET=dev_secret_change_me

# Ingestion schedule (cron). Default: every 15 minutes
INGEST_CRON=*/15 * * * *

# Artist mode: Spotify user id that should see artist controls
ARTIST_SPOTIFY_USER_ID=your_spotify_user_id

# Seed the FIRST challenge only when the `challenges` table is empty (fresh DB or first deploy).
# New releases after that: insert a row into `challenges` (or adjust env + empty DB) — not exposed in the web UI.
# Each challenge runs for a fixed window; ingest only counts plays while the window is live.
CAMPAIGN_TITLE=May 6 Release Challenge
CAMPAIGN_TRACK_ID=3n3Ppam7vgaVa1iaRUc9Lp
CAMPAIGN_TRACK_NAME=Your Release Song
CAMPAIGN_STARTS_AT=2026-05-06T00:00:00Z
CAMPAIGN_ENDS_AT=2026-05-13T00:00:00Z

