# Last.fm API — create an application at https://www.last.fm/api/account/create
# Set the callback URL to match production/dev, e.g. http://127.0.0.1:8787/auth/callback
LASTFM_API_KEY=your_api_key
LASTFM_API_SECRET=your_api_secret
# Optional: set to 1 to add per-request `cb=` to the Last.fm auth URL. Default (omit) uses only the
# callback URL saved in your Last.fm app — try that first if Last.fm doesn't redirect after approve.
# LASTFM_AUTH_USE_CB=1

# Public site origin (no trailing slash)
FRONTEND_ORIGIN=http://127.0.0.1:5173

SESSION_SECRET=change_me_to_a_long_random_string

# Challenge (optional overrides — defaults in backend/src/challenges.js match a short turkeys test window)
# CAMPAIGN_TITLE=Release challenge
# CAMPAIGN_ARTIST=Eva Snyder
# CAMPAIGN_TRACK_NAME=turkeys
# CAMPAIGN_STARTS_AT=2026-03-27T00:00:00Z
# CAMPAIGN_ENDS_AT=2026-04-01T00:00:00Z

# Artist mode: Last.fm username (lowercase match) for /api/admin/* tools
# ARTIST_LASTFM_USERNAME=your_lastfm_username

# SQLite path (default ./data.sqlite)
# DB_PATH=./data.sqlite

# Ingest schedule (cron)
# INGEST_CRON=*/15 * * * *
