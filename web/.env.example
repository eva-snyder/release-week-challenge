# Production only: public URL of your Express API. In `npm run dev`, OAuth always uses
# http://127.0.0.1:8787 (or VITE_BACKEND_PORT) so a mistaken frontend URL here cannot break login.
# VITE_BACKEND_ORIGIN=https://api.yourdomain.com
# VITE_BACKEND_PORT=8787

VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# Optional. Must be listed as a Redirect URI in your Spotify app settings.
# Defaults to: http://localhost:5173/callback (or whatever origin Vite uses)
# VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

